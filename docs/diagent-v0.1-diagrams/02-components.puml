@startuml
!pragma layout smetana
title 02  DiAgent 内部 · 共享执行与配置装配（目标设计）
skinparam backgroundColor #F9FBFE
skinparam defaultFontName Microsoft YaHei
skinparam defaultFontColor #14273E
skinparam ArrowColor #446483
skinparam Shadowing false
skinparam roundcorner 10
skinparam packageStyle rectangle
skinparam componentStyle uml2
skinparam componentBorderColor #7595B4
skinparam nodeBorderColor #7896B2
skinparam databaseBorderColor #7896B2
skinparam artifactBorderColor #7896B2
top to bottom direction
component "DiOS / 外部调度器" as OS #E0EDFF
node "DiAgent 容器 · 可运行任一入口" as Box #F0F5FC {
  package "TypeScript 主进程" as TS #EFF5FE {
    component "Task 入口\n配置、结果文件与退出码" as Task #E0EDFF
    component "HTTP 入口\nChat / SSE 与健康检查" as Http #E0EDFF
    component "共享 profile 装配\n校验插件、参数和权限" as Config #FFFFFF
    component "runDshTurn + DSH SDK\n会话、事件与收尾" as Run #FFFFFF
    artifact "内置配置\n基础 · 模型与角色，零业务工具\n一次性任务默认 · 产物与预算\n常驻对话默认 · 历史与 SSE" as Defaults #FFF6E6
    Task -[hidden]right- Http
    Task -down-> Config : 任务请求
    Http -down-> Config : 对话请求
    Defaults -right-> Config : 继承基础与选定默认项
    Config -down-> Run : 本次生效的 profile
  }
  package "DSH 子进程" as Child #EDF7F3 {
    component "DSH 会话与模型循环" as Core #DDF2E9
    component "本次获准的工具\n文件、Skills、MCP、Shell、事件" as Tools #DDF2E9
    Core -right-> Tools
  }
}
folder "挂载的 /workspace" as Work #FFFFFF
OS -down-> Task : TASK_CONFIG 与本次授权
OS -down-> Http : HTTP / SSE 与本次授权
Run -down-> Core : stdio JSON-RPC
Tools --> Work : 获准时访问
@enduml
