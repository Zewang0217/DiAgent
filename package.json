{
  "name": "diagent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.9.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "task:dsh": "node dist/task/main.js",
    "service:dsh": "node dist/service/server.js",
    "task-api:dsh": "node dist/task-api/server.js",
    "test:task-api": "npm run build && node --test tests/standalone-task-api.test.mjs",
    "test:service": "npm run build && node --test tests/dsh-service.test.mjs",
    "test:task": "npm run build && node --test --test-concurrency=1 tests/dsh-task.test.mjs tests/publish-event.test.mjs tests/task-result-protocol.test.mjs tests/task-tool-events.test.mjs"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh": "0.2.2-rc.3",
    "@deepseek-ai/dsh-agent": "0.2.2-rc.3",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.3",
    "@deepseek-ai/dsh-mcp-client": "0.2.2-rc.3",
    "@deepseek-ai/dsh-sdk-client": "0.2.2-rc.3",
    "@deepseek-ai/dsh-session": "0.2.2-rc.3",
    "@deepseek-ai/dsh-shell-env": "0.2.2-rc.3",
    "@deepseek-ai/dsh-skill-filesystem": "0.2.2-rc.3",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.3",
    "@modelcontextprotocol/client": "2.3.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/node": "24.9.1",
    "typescript": "5.9.3"
  },
  "overrides": {
    "undici": "8.12.2",
    "fflate": "0.8.3",
    "@modelcontextprotocol/client": "2.3.0"
  }
}
